# UTMS7 build file

AS = nasm
CC = gcc
LD = ld
MKMOD = tools/mkmod

ASFLAGS = -f elf64
CFLAGS = -m64 -ffreestanding -nostdlib -Iinclude -fno-stack-protector -mno-red-zone -O2 -g
KCFLAGS = $(CFLAGS) -mno-sse
UCFLAGS = $(CFLAGS) -msse2
LDFLAGS = -m elf_x86_64 -T linker.ld -nostdlib

B = build

# Kernel object pattern rules
$(B)/kernel/arch/x86_64/%.o: kernel/arch/x86_64/%.c
	mkdir -p $(B)/kernel/arch/x86_64
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/kernel/arch/x86_64/%.o: kernel/arch/x86_64/%.asm
	mkdir -p $(B)/kernel/arch/x86_64
	$(AS) $(ASFLAGS) -o $@ $<
eoc

$(B)/kernel/arch/x86_64/%.o: kernel/arch/x86_64/%.S
	mkdir -p $(B)/kernel/arch/x86_64
	$(AS) $(ASFLAGS) -o $@ $<
eoc

$(B)/kernel/arch/x86_64/syscall_asm.o: kernel/arch/x86_64/syscall.asm
	mkdir -p $(B)/kernel/arch/x86_64
	$(AS) $(ASFLAGS) -o $@ $<
eoc

$(B)/kernel/core/%.o: kernel/core/%.c
	mkdir -p $(B)/kernel/core
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/kernel/drivers/storage/%.o: kernel/drivers/storage/%.c
	mkdir -p $(B)/kernel/drivers/storage
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/kernel/drivers/input/%.o: kernel/drivers/input/%.c
	mkdir -p $(B)/kernel/drivers/input
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/kernel/drivers/gpu/%.o: kernel/drivers/gpu/%.c
	mkdir -p $(B)/kernel/drivers/gpu
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/kernel/drivers/pci/%.o: kernel/drivers/pci/%.c
	mkdir -p $(B)/kernel/drivers/pci
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/kernel/fs/%.o: kernel/fs/%.c
	mkdir -p $(B)/kernel/fs
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

# Userspace object pattern rules
$(B)/apps/core/%.o: apps/core/%.c
	mkdir -p $(B)/apps/core
	$(CC) $(UCFLAGS) -c -o $@ $<
eoc

$(B)/apps/disk/%.o: apps/disk/%.c
	mkdir -p $(B)/apps/disk
	$(CC) $(UCFLAGS) -c -o $@ $<
eoc

$(B)/apps/cc/%.o: apps/cc/%.c
	mkdir -p $(B)/apps/cc
	$(CC) $(UCFLAGS) -c -o $@ $<
eoc

$(B)/lib/%.o: lib/%.c
	mkdir -p $(B)/lib
	$(CC) $(UCFLAGS) -c -o $@ $<
eoc

$(B)/lib/crt0.o: lib/crt0.asm
	mkdir -p $(B)/lib
	$(AS) $(ASFLAGS) -o $@ $<
eoc

# Other components
$(B)/adders/%.o: adders/%.c
	mkdir -p $(B)/adders
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/net/%.o: net/%.c
	mkdir -p $(B)/net
	$(CC) $(KCFLAGS) -c -o $@ $<
eoc

$(B)/linux_compat/%.o: linux_compat/%.c
	mkdir -p $(B)/linux_compat
	$(CC) $(KCFLAGS) -Ilinux_compat -Ilinux_compat/uapi -c -o $@ $<
eoc

# Object groups
ARCH = $(B)/kernel/arch/x86_64/entry.o $(B)/kernel/arch/x86_64/isr.o $(B)/kernel/arch/x86_64/syscall_asm.o $(B)/kernel/arch/x86_64/gdt_flush.o $(B)/kernel/arch/x86_64/gdt.o $(B)/kernel/arch/x86_64/idt.o $(B)/kernel/arch/x86_64/paging.o $(B)/kernel/arch/x86_64/irq.o

KRN = $(B)/kernel/core/kernel.o $(B)/kernel/core/sched.o $(B)/kernel/core/memory.o $(B)/kernel/core/vfs.o $(B)/kernel/core/unix.o $(B)/kernel/core/panic.o $(B)/kernel/core/kmod.o $(B)/kernel/core/binfmt.o $(B)/kernel/core/elf.o $(B)/kernel/core/syscall.o $(B)/kernel/core/acpi.o

STR = $(B)/kernel/drivers/storage/disk.o $(B)/kernel/drivers/storage/ahci.o $(B)/kernel/drivers/storage/mbr.o $(B)/kernel/drivers/storage/gpt.o $(B)/kernel/drivers/storage/udisk.o

INP = $(B)/kernel/drivers/input/keyboard.o $(B)/kernel/drivers/input/mouse.o

GPU = $(B)/kernel/drivers/gpu/drm.o $(B)/kernel/drivers/gpu/i915.o

PCI = $(B)/kernel/drivers/pci/pci.o

FS = $(B)/kernel/fs/ufs.o $(B)/kernel/fs/fat.o $(B)/kernel/fs/fat32.o $(B)/kernel/fs/ext4.o $(B)/kernel/fs/procfs.o $(B)/kernel/fs/devfs.o

NET = $(B)/net/arp.o $(B)/net/ip.o $(B)/net/icmp.o $(B)/net/tcp.o $(B)/net/udp.o $(B)/net/dhcp.o $(B)/net/dns.o $(B)/net/http.o $(B)/net/net.o $(B)/net/e1000.o $(B)/net/rtl8139.o $(B)/net/netconfig.o

LCMP = $(B)/linux_compat/pci.o $(B)/linux_compat/interrupt.o $(B)/linux_compat/dma.o $(B)/linux_compat/virtio_gpu.o

ADD = $(B)/adders/ski.o

LIBC = $(B)/lib/string.o $(B)/lib/ctype.o $(B)/lib/stdlib.o $(B)/lib/stdio.o $(B)/lib/errno.o $(B)/lib/libc.o
CRT = $(B)/lib/crt0.o $(LIBC)
LIB = $(B)/lib/font.o $(B)/lib/zlib.o $(LIBC)

ALL = $(ARCH) $(KRN) $(STR) $(INP) $(GPU) $(PCI) $(FS) $(NET) $(LIB) $(LCMP) $(ADD)

# Kernel binary
$(B)/kernel.bin: $(ALL)
	mkdir -p $(B)
	$(LD) $(LDFLAGS) -o $@ $(ALL)
eoc

# Userspace apps
$(B)/bin/%.bin: $(B)/apps/core/%.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $<
eoc

$(B)/bin/udisk.bin: $(B)/apps/disk/udisk.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $(B)/apps/disk/udisk.o
eoc

$(B)/bin/lsblk.bin: $(B)/apps/disk/lsblk.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $(B)/apps/disk/lsblk.o
eoc

$(B)/bin/mount.bin: $(B)/apps/disk/mount.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $(B)/apps/disk/mount.o
eoc

$(B)/bin/umount.bin: $(B)/apps/disk/umount.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $(B)/apps/disk/umount.o
eoc

$(B)/bin/mkfs.bin: $(B)/apps/disk/mkfs.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $(B)/apps/disk/mkfs.o
eoc

$(B)/bin/cc.bin: $(B)/apps/cc/main.o $(B)/apps/cc/lexer.o $(B)/apps/cc/parser.o $(B)/apps/cc/ast.o $(B)/apps/cc/codegen.o $(B)/apps/cc/elf.o $(CRT)
	mkdir -p $(B)/bin
	$(LD) -m elf_x86_64 -T user.ld -nostdlib -o $@ $(CRT) $(B)/apps/cc/main.o $(B)/apps/cc/lexer.o $(B)/apps/cc/parser.o $(B)/apps/cc/ast.o $(B)/apps/cc/codegen.o $(B)/apps/cc/elf.o
eoc

# All binaries
BINS = $(B)/bin/init.bin $(B)/bin/sfsh.bin $(B)/bin/ls.bin $(B)/bin/mkdir.bin $(B)/bin/touch.bin $(B)/bin/rm.bin $(B)/bin/cat.bin $(B)/bin/cp.bin $(B)/bin/mk.bin $(B)/bin/rmdir.bin $(B)/bin/hex.bin $(B)/bin/editor.bin $(B)/bin/test_libc.bin $(B)/bin/chroot.bin $(B)/bin/udisk.bin $(B)/bin/lsblk.bin $(B)/bin/mount.bin $(B)/bin/umount.bin $(B)/bin/mkfs.bin $(B)/bin/cc.bin

# Modules
kom: $(B)/kernel/drivers/storage/mbr.o $(B)/kernel/drivers/storage/gpt.o
	mkdir -p modules
	cp $(B)/kernel/drivers/storage/mbr.o modules/mbr.ko
	cp $(B)/kernel/drivers/storage/gpt.o modules/gpt.ko
	echo " MODULES BUILT "
eoc

# ISO
iso: $(B)/kernel.bin $(BINS) kom
	echo " CREATING ISO "
	rm -rf iso
	mkdir -p iso/boot/grub iso/modules
	cp $(B)/kernel.bin iso/boot/kernel.bin
	cp $(B)/bin/init.bin iso/modules/init.bin
	cp $(B)/bin/sfsh.bin iso/modules/sfsh.bin
	cp $(B)/bin/cc.bin iso/modules/cc.bin
	cp $(B)/bin/udisk.bin iso/modules/udisk.bin
	cp $(B)/bin/lsblk.bin iso/modules/lsblk.bin
	cp $(B)/bin/mount.bin iso/modules/mount.bin
	cp $(B)/bin/umount.bin iso/modules/umount.bin
	cp $(B)/bin/mkfs.bin iso/modules/mkfs.bin
	cp $(B)/bin/ls.bin iso/modules/ls.bin
	cp $(B)/bin/mkdir.bin iso/modules/mkdir.bin
	cp $(B)/bin/touch.bin iso/modules/touch.bin
	cp $(B)/bin/rm.bin iso/modules/rm.bin
	cp $(B)/bin/cat.bin iso/modules/cat.bin
	cp $(B)/bin/cp.bin iso/modules/cp.bin
	cp $(B)/bin/mk.bin iso/modules/mk.bin
	cp $(B)/bin/rmdir.bin iso/modules/rmdir.bin
	cp $(B)/bin/test_libc.bin iso/modules/test_libc.bin
	cp $(B)/bin/hex.bin iso/modules/hex.bin
	cp $(B)/bin/editor.bin iso/modules/editor.bin
	cp $(B)/bin/chroot.bin iso/modules/chroot.bin
	sh -c 'for f in modules/*.ko; do if [ -f "$$f" ]; then cp "$$f" iso/modules/; fi; done'
	sh -c 'echo "set timeout=0" > iso/boot/grub/grub.cfg'
	sh -c 'echo "set default=0" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "menuentry \"UTMS\" {" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    multiboot2 /boot/kernel.bin" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/init.bin init" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/sfsh.bin sfsh" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/cc.bin cc" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/udisk.bin udisk" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/lsblk.bin lsblk" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/mount.bin mount" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/umount.bin umount" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/mkfs.bin mkfs" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/ls.bin ls" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/mkdir.bin mkdir" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/touch.bin touch" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/rm.bin rm" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/cat.bin cat" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/cp.bin cp" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/mk.bin mk" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/test_libc.bin test_libc" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/hex.bin hex" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/editor.bin editor" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    module2 /modules/chroot.bin chroot" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "    boot" >> iso/boot/grub/grub.cfg'
	sh -c 'echo "}" >> iso/boot/grub/grub.cfg'
	grub-mkrescue -o utms.iso iso/
eoc

disk1g.img:
	dd if=/dev/zero of=disk1g.img bs=1M count=1024
eoc

build:
	echo " BUILDING UTMS "
	call $(B)/kernel.bin
	call $(B)/bin/init.bin
	call $(B)/bin/sfsh.bin
	call $(B)/bin/cc.bin
	call $(B)/bin/udisk.bin
	call $(B)/bin/lsblk.bin
	call $(B)/bin/mount.bin
	call $(B)/bin/umount.bin
	call $(B)/bin/mkfs.bin
	call $(B)/bin/ls.bin
	call $(B)/bin/mkdir.bin
	call $(B)/bin/touch.bin
	call $(B)/bin/rm.bin
	call $(B)/bin/cat.bin
	call $(B)/bin/cp.bin
	call $(B)/bin/mk.bin
	call $(B)/bin/rmdir.bin
	call $(B)/bin/chroot.bin
	call kom
	echo " BUILD COMPLETE "
eoc

run: iso
	echo "STARTING UTMS"
	qemu-system-x86_64 -cdrom utms.iso -m 512 -drive id=disk1,file=disk1g.img,format=raw,if=none -device ahci,id=ahci -device ide-hd,drive=disk1,bus=ahci.0 -vga none -netdev user,id=net0 -device rtl8139,netdev=net0 -boot d -serial stdio -display gtk -device virtio-gpu-pci,xres=1920,yres=1080
eoc

debug: iso disk1g.img
	echo " STARTING UTMS (debug) "
	qemu-system-x86_64 -cdrom utms.iso -m 512 -drive id=disk1,file=disk1g.img,format=raw,if=none -device ahci,id=ahci -device ide-hd,drive=disk1,bus=ahci.0 -vga vmware -global VGA.vgamem_mb=64 -netdev user,id=net0 -device rtl8139,netdev=net0 -boot d -s -S
eoc

runD:
	call iso
	qemu-system-x86_64 -cdrom utms.iso -m 512 -hda disk1g.img -vga std -netdev user,id=net0 -device rtl8139,netdev=net0 -boot d -no-reboot -no-shutdown -device virtio-gpu-pci,xres=1024,yres=768 -d int,cpu_reset -D ./qemu.log
eoc

run-disk: $(B)/kernel.bin disk1g.img
	echo " STARTING UTMS (disk only) "
	qemu-system-x86_64 -kernel $(B)/kernel.bin -m 512 -hda disk1g.img -vga std -global VGA.vgamem_mb=64 -netdev user,id=net0 -device rtl8139,netdev=net0 -device virtio-gpu-pci,xres=1024,yres=768
eoc

run-serial: iso disk1g.img
	echo " STARTING UTMS (serial) "
	qemu-system-x86_64 -cdrom utms.iso -m 512 -hda disk1g.img -vga std -global VGA.vgamem_mb=64 -netdev user,id=net0 -device rtl8139,netdev=net0 -boot d -serial stdio -device virtio-gpu-pci,xres=1024,yres=768
eoc

run-e1000: iso disk1g.img
	echo " STARTING UTMS (e1000) "
	qemu-system-x86_64 -cdrom utms.iso -m 512 -hda disk1g.img -vga std -global VGA.vgamem_mb=64 -netdev user,id=net0 -device e1000,netdev=net0 -boot d -device virtio-gpu-pci,xres=1024,yres=768
eoc

clean:
	echo " CLEANING "
	rm -rf $(B) modules iso utms.iso
	rm -f *.bin
	+flags:
		-fg(all):
			echo "[ALL] Full clean with disks..."
			rm -rf disk*.img
		eofg
	;
eoc
